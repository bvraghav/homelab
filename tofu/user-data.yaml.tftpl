#cloud-config
# First boot of every VM: name, user, SSH key, guest agent. No secrets:
# they're pushed over SSH afterwards (scripts/push-secrets.sh).
hostname: ${hostname}
fqdn: ${fqdn}
manage_etc_hosts: true
timezone: UTC

users:
  - name: ${user}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_key}

ssh_pwauth: false
disable_root: true

package_update: true
package_upgrade: true
packages:
  - qemu-guest-agent

runcmd:
  - systemctl enable --now qemu-guest-agent
